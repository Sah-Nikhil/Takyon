# Dependencies
node_modules/

# Build output
dist/
apps/*/dist/

# Rust
target/
apps/*/src-tauri/target/

# Tauri generated schemas (regenerated by tauri-build)
apps/*/src-tauri/gen/schemas/

# Benchmark output — machine-specific numbers. The conclusions get written into
# docs/tbc/0002 by hand; the raw runs do not belong in the repo.
bench/results/
*.bench.jsonl

# Playwright visual-regression artifacts. Baselines under __screenshots__/ ARE
# committed; failures, traces and reports are not.
test-results/
playwright-report/
blob-report/
.playwright/

# Updater signing key — the PRIVATE key only. The pubkey lives in tauri.conf.json.
.updater-key
*.updater-key
takyon-updater.key
takyon-updater.key.*
!takyon-updater.key.pub

# Code-signing material for the UIAccess helper (v0.1 task 9). A uiAccess="true"
# binary is only trusted because it is signed; the cert and its password never
# go in the repo.
*.pfx
*.p12
*.snk
signing.secrets.ps1*

# Secrets. Brave Search API key (v0.8) and anything else env-shaped.
.env
.env.*
!.env.example

# Release artifacts
releases/

# TypeScript incremental build state — machine-local
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
