{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The Settings window. Separate from the Palette's capability so the Palette never gains a permission it has no reason to hold.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "autostart:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
