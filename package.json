{
  "name": "takyon",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "brand"
  ],
  "scripts": {
    "dev": "bun --cwd=apps/desktop run tauri dev",
    "build": "bun --cwd=apps/desktop run tauri build",
    "typecheck": "bun run --filter=@takyon/desktop typecheck && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "bun run lint:ts && bun run lint:rust",
    "lint:ts": "bun run --filter=@takyon/desktop lint && bun run --filter=@takyon/shared lint",
    "lint:rust": "cargo clippy --workspace --all-targets --manifest-path apps/desktop/src-tauri/Cargo.toml -- -D warnings",
    "test": "bun run test:rust && bun run test:ts",
    "test:rust": "cargo test --workspace --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:ts": "bun test apps/desktop/src packages/shared/src",
    "test:visual": "bun --cwd=apps/desktop run test:visual",
    "bench": "bun scripts/bench.ts",
    "brand": "bun run --cwd brand build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
